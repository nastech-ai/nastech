# NasTech CLI Development Environment
#
# This file is for direnv users who want automatic environment switching
# when entering this directory.
#
# Setup:
#   1. Install direnv: https://direnv.net/
#   2. Copy this file: cp .envrc.example .envrc
#   3. Run: direnv allow
#
# The .envrc file is gitignored, so each developer can customize it.

export NASTECH_HOME_DIR="$HOME/.nastech-dev"
export NASTECH_VARIANT="dev"
export NASTECH_SERVER_URL="${NASTECH_SERVER_URL:-https://api.nastech.workers.dev}"

echo "🔧 DEV environment activated (data: $NASTECH_HOME_DIR)"
