{
  "cli": {
    "version": ">= 14.2.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "cache": {
        "key": "dev-gradle-v1",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "development",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "development-store": {
      "autoIncrement": true,
      "developmentClient": true,
      "distribution": "store",
      "channel": "development",
      "cache": {
        "key": "dev-store-gradle-v1",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "development",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "android-apk": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "cache": {
        "key": "android-apk-gradle-v2",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "SKIP_NASTECH_WIRE_BUILD": "1",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      }
    },
    "preview": {
      "autoIncrement": true,
      "distribution": "internal",
      "channel": "preview",
      "cache": {
        "key": "preview-gradle-v1",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "preview-store": {
      "autoIncrement": true,
      "distribution": "store",
      "channel": "preview",
      "cache": {
        "key": "preview-store-gradle-v1",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "preview",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "cache": {
        "key": "production-gradle-v1",
        "cacheDefaultPaths": true
      },
      "env": {
        "APP_ENV": "production",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      }
    }
  },
  "submit": {
    "development-store": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    },
    "preview-store": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    },
    "production": {
      "ios": {
        "appleId": "",
        "ascAppId": "",
        "appleTeamId": ""
      }
    }
  }
}
